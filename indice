            const cidadeDigitada   = document.getElementById('new-cidade').value.trim();
            const ufDigitada       = document.getElementById('new-uf').value;

            const erroEndereco = validarEndereco(enderecoDigitado, cidadeDigitada, ufDigitada);
            if (erroEndereco) {
                mostrarErroEndereco(erroEndereco);
                alert(erroEndereco);
                return;
            }
            mostrarErroEndereco(null);

            const lacresLona = [document.getElementById('new-lacre-lona-1').value.trim()];
            if (veiculo === 'CARRETA') lacresLona.push(document.getElementById('new-lacre-lona-2').value.trim());

