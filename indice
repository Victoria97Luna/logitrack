        // Move a parada atual uma posição para cima (-1) ou para baixo (+1).
        // Vale para o motorista se organizar; a sequência original era
        // só uma sugestão por endereço.
        async function moverParada(indice, direcao) {
            const paradas = [...(PORTAL.ordem.paradas || [])];
            const destino = indice + direcao;
            if (destino < 0 || destino >= paradas.length) return;

            // troca as duas de lugar
            const aux = paradas[indice];
            paradas[indice] = paradas[destino];
            paradas[destino] = aux;

            try {
                await reordenarParadasPorToken(PORTAL.token, paradas.map(x => x.itemId));
            } catch (err) {
                console.error(err);
                alert('Não foi possível mudar a ordem: ' + mensagemErro(err));
                return;
            }

            const atualizada = await carregarPortalPorToken(PORTAL.token);
            if (atualizada) PORTAL.ordem = atualizada;

            // acompanha a parada que o motorista estava vendo
            PORTAL.paradaAtual = destino;
            renderParadaAtual();
            showToast('Ordem da rota atualizada.');
        }

        async function salvarParadaAtual() {
            const paradas = PORTAL.ordem.paradas || [];
            const p = paradas[PORTAL.paradaAtual];
            if (!p) return;

            const cav = parseInt(document.getElementById('portal-cav').value, 10);
            const lon = parseInt(document.getElementById('portal-lon').value, 10);
            const for_ = parseInt(document.getElementById('portal-for').value, 10);
            const cin = parseInt(document.getElementById('portal-cin').value, 10);
            const obs = document.getElementById('portal-obs-parada').value.trim();

            if ([cav, lon, for_, cin].some(v => !Number.isFinite(v) || v < 0)) {
                alert('Preencha as quantidades com números válidos (zero ou mais).');
                return;
            }

            const mudou = cav !== p.prevCavaletes || lon !== p.prevLonas ||
                          for_ !== p.prevForros || cin !== p.prevCintas;

            if (mudou && !obs) {
                alert('A quantidade está diferente do previsto.\nExplique o motivo na observação.');
                document.getElementById('portal-obs-parada').focus();
                return;
            }

            try {
                await confirmarParadaPorToken(PORTAL.token, p.itemId, cav, lon, for_, cin, obs);
            } catch (err) {
                console.error(err);
                alert('Não foi possível salvar esta parada: ' + mensagemErro(err));
                return;
            }

            // recarrega a ordem do servidor para refletir o que ficou gravado
            const atualizada = await carregarPortalPorToken(PORTAL.token);
            if (atualizada) PORTAL.ordem = atualizada;

            const novas = PORTAL.ordem.paradas || [];
            const proxima = novas.findIndex(x => x.coletCavaletes === null);

            if (proxima === -1) {
                showToast('Todas as paradas conferidas. Confirme para fechar a coleta.');
            } else {
                PORTAL.paradaAtual = proxima;
                showToast(`Parada ${p.parada} conferida.`);
            }
            renderParadaAtual();
        }

