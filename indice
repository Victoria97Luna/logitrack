    <script>
        /* =========================================================================
           LogiTrack — fila de operações offline

           Motorista no galpão do cliente, sem sinal: a operação fica
           guardada no aparelho e sobe sozinha quando a internet voltar.
           ========================================================================= */

/* =====================================================================
   LogiTrack — fila de operações offline

   Cenário real: o motorista está no galpão do cliente, no fundo de um
   barracão, sem sinal. Ele confere a parada e confirma a coleta. Se a
   operação se perdesse, ele teria que refazer tudo depois.

   Como funciona:
     • cada escrita é tentada na hora;
     • se falhar por falta de internet, entra numa fila no aparelho;
     • quando a internet volta, a fila sobe sozinha, na ordem certa;
     • a tela mostra quantas operações estão aguardando.

   Importante: a fila guarda operações, não dados. O servidor continua
   sendo a verdade — nada é "decidido" no aparelho.
   ===================================================================== */

const CHAVE_FILA = 'logitrack.fila.v1';

function lerFila() {
  try {
    return JSON.parse(localStorage.getItem(CHAVE_FILA) || '[]');
  } catch (e) {
    return [];
  }
}

function gravarFila(fila) {
  localStorage.setItem(CHAVE_FILA, JSON.stringify(fila));
  atualizarAvisoFila();
}

function enfileirar(operacao) {
  const fila = lerFila();
  fila.push({
    id: Date.now() + '-' + Math.random().toString(36).slice(2, 8),
    quando: new Date().toISOString(),
    tentativas: 0,
    ...operacao
  });
  gravarFila(fila);
}

// Diz se o erro foi de conexão (vale guardar) ou de regra (não vale).
function erroDeRede(err) {
  if (!err) return false;
  const msg = String(err.message || err || '');
  return /Failed to fetch|NetworkError|ERR_NETWORK|ERR_INTERNET|fetch failed|load failed|timeout|network/i.test(msg);
}

/* ---------------------------------------------------------------------
   Executa uma escrita: tenta agora; se for problema de rede, guarda.
   --------------------------------------------------------------------- */
async function escreverOuEnfileirar(funcao, params, rotulo) {
  try {
    const { data, error } = await sb.rpc(funcao, params);
    if (error) throw error;
    return { ok: true, dados: data };
  } catch (err) {
    if (erroDeRede(err)) {
      enfileirar({ funcao, params, rotulo });
      return { ok: false, enfileirado: true, erro: err };
    }
    // erro de regra do banco: repassa, não faz sentido repetir depois
    return { ok: false, erro: err };
  }
}

/* ---------------------------------------------------------------------
   Sobe a fila quando a internet volta
   --------------------------------------------------------------------- */
let SINCRONIZANDO = false;

async function sincronizarFila() {
  if (SINCRONIZANDO) return;
  if (!navigator.onLine) return;

  const fila = lerFila();
  if (!fila.length) return;

  SINCRONIZANDO = true;
  atualizarAvisoFila();

  const restantes = [];
  let subiram = 0;

  for (const op of fila) {
    try {
      const { error } = await sb.rpc(op.funcao, op.params);
      if (error) throw error;
      subiram++;
    } catch (err) {
      if (erroDeRede(err)) {
        // ainda sem internet: mantém tudo para a próxima tentativa
        restantes.push(op);
      } else {
        // o banco recusou (ex.: a ordem já foi confirmada em outro
        // aparelho). Insistir não resolve: descarta e avisa.
        console.warn('Operação descartada da fila:', op.rotulo, err);
        mostrarOperacaoDescartada(op, err);
      }
    }
  }

  // preserva as que ainda não subiram
  const naoProcessadas = fila.filter(
    (f) => !restantes.some((r) => r.id === f.id) && f.tentativas > 0
  );
  gravarFila(restantes);
  SINCRONIZANDO = false;

  if (subiram > 0) {
    showToast(`${subiram} operação(ões) pendente(s) enviada(s) ao sistema.`);
    if (typeof recarregar === 'function') await recarregar();
  }

  atualizarAvisoFila();
}

function mostrarOperacaoDescartada(op, err) {
  const msg = (err && err.message) || String(err);
  console.warn('Não enviada:', op.rotulo, msg);
  showToast(`Uma operação não pôde ser enviada: ${msg}`, 'info');
}

/* ---------------------------------------------------------------------
   Aviso na tela
   --------------------------------------------------------------------- */
function atualizarAvisoFila() {
  const el = document.getElementById('aviso-fila');
  if (!el) return;

  const fila = lerFila();

  if (!fila.length) {
    el.classList.add('hidden');
    el.innerHTML = '';
    return;
  }

  const online = navigator.onLine;
  el.classList.remove('hidden');
  el.className = online
    ? 'fixed bottom-4 right-4 z-40 max-w-xs p-3 rounded-xl shadow-2xl text-xs font-bold bg-amber-500 text-white'
    : 'fixed bottom-4 right-4 z-40 max-w-xs p-3 rounded-xl shadow-2xl text-xs font-bold bg-rose-600 text-white';

  el.innerHTML = `
      <div class="flex items-center gap-2">
        <span class="text-base">${online ? '⏳' : '📴'}</span>
        <div class="leading-tight">
          <div>${fila.length} operação(ões) aguardando</div>
          <div class="font-normal opacity-90 text-[10px]">
            ${online ? 'Enviando...' : 'Sem internet — enviamos quando voltar'}
          </div>
        </div>
      </div>`;
}

/* ---------------------------------------------------------------------
   Liga os gatilhos
   --------------------------------------------------------------------- */
function iniciarModoOffline() {
  window.addEventListener('online', () => {
    showToast('Conexão voltou. Enviando o que estava pendente...');
    sincronizarFila();
  });

  window.addEventListener('offline', () => {
    atualizarAvisoFila();
  });

  // tenta de tempos em tempos, para o caso de o aviso de "online"
  // do navegador não disparar (acontece em redes instáveis)
  setInterval(() => {
    if (navigator.onLine && lerFila().length) sincronizarFila();
  }, 30000);

  atualizarAvisoFila();
  if (navigator.onLine) sincronizarFila();
}

