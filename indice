async function carregarDados() {
    if (!PERFIL_ADMIN) {
        // Motorista: só as próprias coletas, por RPC dedicada.
        const { data, error } = await sb.rpc('minhas_coletas');
        if (error) { console.error(error); return; }
        db.ordensColeta = data || [];
        db.pedidos = [];
        db.entradas = [];
        db.saidas = [];
        db.estoqueLacres = [];
        db.historico = [];
        return;
    }

    const { data, error } = await sb.rpc('carregar_dados');
    if (error) {
        console.error('Erro ao carregar dados', error);
        showToast('Não foi possível carregar os dados.', 'info');
        return;
    }

    db = {
        pedidos:        data.pedidos        || [],
        ordensColeta:   data.ordensColeta   || [],
        entradas:       data.entradas       || [],
        saidas:         data.saidas         || [],
        estoqueLacres:  data.estoqueLacres  || [],
        historico:      data.historico      || [],
        cintas:         data.cintas || { novas: 0, usadas: 0 }
    };
}

