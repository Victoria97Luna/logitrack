async function iniciarAplicacao() {
    await carregarDados();
    await recarregarCintas();

    aplicarPermissoesNaTela();

    if (ehAdmin()) {
        atualizarTodosOsModulos();
        aoMudarTipoVeiculo('BITRUCK');
        await carregarUsuarios();
    } else if (podeLancar()) {
        atualizarTodosOsModulos();
        aoMudarTipoVeiculo('BITRUCK');
    } else {
        // Motorista: abre direto nas coletas dele.
        switchTab('coletas');
        renderColetasSeparadasTables();
        renderOrdensColetaTable();
        lucide.createIcons();
    }

    // se chegou por link de coleta, abre o portal
    const portal = extrairTokenDaUrl();
    if (portal) await abrirPortalPorToken(portal);
}

function extrairTokenDaUrl() {
    const hash = window.location.hash || '';
    if (hash.includes('coleta=')) {
        return decodeURIComponent(hash.split('coleta=')[1]);
    }
    const q = new URLSearchParams(window.location.search).get('coleta');
    return q || null;
}

