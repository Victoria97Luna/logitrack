   ========================================================================= */

/* -------------------------------------------------------------------------
   CONEXÃO COM O BANCO

   Na primeira vez que o sistema abre, ele pede a URL do projeto e a
   chave anon do Supabase numa tela própria — ninguém precisa abrir o
   HTML num editor de texto para configurar.

   As duas ficam guardadas no próprio navegador (localStorage). A chave
   anon é pública por natureza: ela só permite o que o RLS autorizar.
   ------------------------------------------------------------------------- */

const CHAVE_CONFIG = 'logitrack.config.v1';

let SUPABASE_URL = '';
let SUPABASE_ANON_KEY = '';
let sb = null;

function lerConfig() {
    try {
        const bruto = localStorage.getItem(CHAVE_CONFIG);
        if (!bruto) return null;
        const c = JSON.parse(bruto);
        if (!c || !c.url || !c.chave) return null;
        return c;
    } catch (e) {
        return null;
    }
}

function salvarConfig(url, chave) {
    const limpa = String(url || '').trim().replace(/\/+$/, '');
    const c = { url: limpa, chave: String(chave || '').trim() };
    localStorage.setItem(CHAVE_CONFIG, JSON.stringify(c));
    return c;
}

function esquecerConfig() {
    localStorage.removeItem(CHAVE_CONFIG);
    location.reload();
}

// Cria o cliente só quando já existe configuração.
function conectarBanco() {
    const c = lerConfig();
    if (!c) return false;

    SUPABASE_URL = c.url;
    SUPABASE_ANON_KEY = c.chave;

    if (!window.supabase) return false;

    sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
    return true;
}

// A URL e a chave têm cara reconhecível? Serve para avisar antes de
// gravar algo errado e a pessoa ficar sem entender por que não conecta.
function validarConfig(url, chave) {
    const u = String(url || '').trim();
    const k = String(chave || '').trim();

    if (!u) return 'Informe a URL do projeto (Project URL).';
    if (!/^https?:\/\//i.test(u)) return 'A URL precisa começar com https://';
    if (!u.includes('.supabase.co') && !u.startsWith('http://localhost') && !u.startsWith('http://127.')) {
        return 'A URL deve ser algo como https://seuprojeto.supabase.co';
    }
    if (!k) return 'Informe a chave anon (anon public key).';
    if (k.length < 40) return 'A chave anon parece curta demais. Copie a chave inteira (anon public).';
    return null;
}

