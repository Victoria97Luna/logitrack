                document.getElementById('portal-form-container').classList.add('hidden');
                document.getElementById('portal-success-container').classList.remove('hidden');
            } else {
                document.getElementById('portal-form-container').classList.remove('hidden');
                document.getElementById('portal-success-container').classList.add('hidden');
                // começa na primeira parada ainda não conferida
                const paradas = ordem.paradas || [];
                const primeiraPendente = paradas.findIndex(p => p.conferidoEm === null ||
                                                                 p.coletCavaletes === null);
                PORTAL.paradaAtual = primeiraPendente >= 0 ? primeiraPendente : 0;
                renderParadaAtual();
            }

            overlay.classList.remove('hidden');
            lucide.createIcons();
        }

