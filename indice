<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LogiTrack - Sistema de Gestão Logística e Insumos</title>
    <link rel="icon" type="image/png" id="app-favicon" href="data:image/png;base64,">

    <!-- App instalável no celular (PWA) -->
    <link rel="manifest" href="manifest.webmanifest">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="LogiTrack">
    <link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
    <!-- Supabase JS SDK -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        navy: {
                            800: '#1e293b',
                            900: '#0f172a',
                            950: '#020617',
                        },
                        brand: {
                            blue: '#1d4ed8',
                            bluelight: '#3b82f6',
                            red: '#dc2626',
                            reddark: '#991b1b',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- SheetJS for Excel Import/Export -->
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap');
        body { font-family: 'Inter', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex flex-col custom-scrollbar">

    <!-- Top Navigation Bar -->
    <header class="bg-navy-950 text-white sticky top-0 z-40 shadow-xl border-b border-navy-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-16">
                <!-- Brand / Logo -->
                <div class="flex items-center gap-3">
                    <img id="header-logo" src="data:image/png;base64,"
                         alt="LogiTrack"
                         class="w-11 h-11 rounded-full shadow-lg shadow-purple-900/40 ring-1 ring-purple-500/40 object-cover">

                    <div>
                        <div class="flex items-center gap-2">
                            <span class="font-extrabold text-lg tracking-tight text-white">LogiTrack</span>
                            <span class="text-[10px] bg-brand-red text-white font-bold px-1.5 py-0.5 rounded tracking-wide uppercase">Insumos & Frotas</span>
                        </div>
                        <p class="text-[11px] text-slate-400">Guaratinguetá / Campo Belo • Operações</p>
                    </div>
                </div>

                <!-- Desktop Action Buttons -->
                <div class="hidden md:flex items-center gap-2">
                    <button id="btn-import-excel" onclick="openModal('modal-import-excel')" class="px-3 py-1.5 text-xs font-semibold bg-navy-800 hover:bg-slate-800 text-slate-200 rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                        <i data-lucide="file-spreadsheet" class="w-4 h-4 text-emerald-400"></i> Importar Excel
                    </button>
                    <button onclick="exportCSV()" class="px-3 py-1.5 text-xs font-semibold bg-navy-800 hover:bg-slate-800 text-slate-200 rounded-lg border border-slate-700 flex items-center gap-1.5 transition">
                        <i data-lucide="download" class="w-4 h-4 text-blue-400"></i> Exportar CSV
                    </button>
                    <button id="btn-chegada-material" onclick="openModal('modal-new-entrada')" class="px-3 py-1.5 text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg flex items-center gap-1.5 transition shadow">
                        <i data-lucide="arrow-down-left" class="w-4 h-4"></i> + Chegada de Material
                    </button>
                    <button id="btn-saida-material" onclick="openModal('modal-new-saida')" class="px-3 py-1.5 text-xs font-semibold bg-brand-red hover:bg-brand-reddark text-white rounded-lg flex items-center gap-1.5 transition shadow">
                        <i data-lucide="arrow-up-right" class="w-4 h-4"></i> + Saída / Descarte
                    </button>
                    <button id="btn-novo-pedido" onclick="openModal('modal-new-order')" class="px-4 py-1.5 text-xs font-bold bg-brand-blue hover:bg-blue-700 text-white rounded-lg flex items-center gap-1.5 transition shadow-lg shadow-brand-blue/30">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> + Novo Pedido
                    </button>
                    <button id="btn-instalar-app" onclick="instalarApp()"
                            class="hidden px-3 py-1.5 text-xs font-bold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg flex items-center gap-1.5 transition shadow"
                            title="Instalar no celular ou computador">
                        <i data-lucide="download" class="w-4 h-4"></i> Instalar
                    </button>
                    <div class="flex flex-col items-end mr-1 leading-tight">
                        <span id="quem-sou" class="text-[10px] font-bold text-slate-300"></span>
                        <span id="badge-papel" class="hidden"></span>
                    </div>
                    <button onclick="sair()" class="px-3 py-1.5 text-xs font-semibold bg-navy-800 hover:bg-slate-800 text-slate-300 rounded-lg border border-slate-700 flex items-center gap-1.5 transition" title="Sair">
                        <i data-lucide="log-out" class="w-4 h-4"></i>
                    </button>
                </div>
            </div>

            <!-- Tab Navigation Links -->
            <div class="flex overflow-x-auto space-x-1 border-t border-slate-800/80 py-2 custom-scrollbar text-xs font-medium">
                <button onclick="switchTab('dashboard')" id="tab-btn-dashboard" class="tab-btn px-3 py-1.5 rounded-lg text-white bg-brand-blue flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="layout-dashboard" class="w-3.5 h-3.5"></i> Dashboard
                </button>
                <button onclick="switchTab('pedidos')" id="tab-btn-pedidos" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="truck" class="w-3.5 h-3.5"></i> Pedidos & Cargas
                </button>
                <button onclick="switchTab('coletas')" id="tab-btn-coletas" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="rotate-ccw" class="w-3.5 h-3.5"></i> Coleta Reversa (Cavaletes & Lonas)
                </button>
                <button onclick="switchTab('solicitar-coleta')" id="tab-btn-solicitar-coleta" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="map-pin" class="w-3.5 h-3.5 text-amber-400"></i> Solicitar Coleta (Link Frota)
                </button>
                <button onclick="switchTab('entradas')" id="tab-btn-entradas" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="box" class="w-3.5 h-3.5 text-emerald-400"></i> Entrada de Materiais
                </button>
                <button onclick="switchTab('saidas')" id="tab-btn-saidas" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="send" class="w-3.5 h-3.5 text-rose-400"></i> Saídas & Descarte
                </button>
                <button onclick="switchTab('estoque')" id="tab-btn-estoque" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="layers" class="w-3.5 h-3.5"></i> Estoque & Lacres
                </button>
                <button onclick="switchTab('historico')" id="tab-btn-historico" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap">
                    <i data-lucide="history" class="w-3.5 h-3.5"></i> Histórico & Trocas
                </button>
                <button onclick="switchTab('usuarios')" id="tab-btn-usuarios" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap hidden">
                    <i data-lucide="users" class="w-3.5 h-3.5"></i> Usuários
                </button>
                <button onclick="switchTab('auditoria')" id="tab-btn-auditoria" class="tab-btn px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-navy-800 flex items-center gap-1.5 whitespace-nowrap hidden">
                    <i data-lucide="shield-check" class="w-3.5 h-3.5"></i> Auditoria
                </button>
            </div>
        </div>
    </header>

    <!-- Main Content Container -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-6">

        <!-- ============================================================== -->
        <!-- TAB 1: DASHBOARD -->
        <!-- ============================================================== -->
        <section id="tab-dashboard" class="tab-content space-y-6">
            <!-- Top Operational Banner -->
            <div class="bg-gradient-to-r from-navy-950 via-navy-900 to-slate-900 text-white rounded-2xl p-6 shadow-xl border border-navy-800 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
                <div>
                    <h1 class="text-2xl font-black tracking-tight text-white">Painel Operacional de Cargas e Insumos</h1>
                    <p class="text-xs sm:text-sm text-slate-300 mt-1 max-w-2xl">
                        Regras automáticas: <span class="font-bold text-white bg-navy-800 px-2 py-0.5 rounded">Bitruck: 1 Cav / 1 Lona / 1 Forro / 4 Cintas</span> • <span class="font-bold text-white bg-navy-800 px-2 py-0.5 rounded">Carreta: 2 Cav / 2 Lonas / 2 Forros / 8 Cintas</span>.
                    </p>
                </div>
                <div class="flex items-center gap-3">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Sistema Pronto
                    </span>
                    <button onclick="resetarDados()" class="px-2.5 py-1 text-[11px] font-medium text-slate-400 hover:text-rose-400 bg-navy-900 hover:bg-navy-800 rounded border border-slate-700">
                        Zerar Base
                    </button>
                </div>
            </div>

            <!-- KPI Metric Cards -->
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3 sm:gap-4">
                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                        <span>Total Pedidos</span>
                        <i data-lucide="package" class="w-4 h-4 text-blue-600"></i>
                    </div>
                    <div class="text-2xl font-black text-navy-950 mt-2" id="kpi-total-pedidos">0</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Cadastrados no sistema</div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                        <span>Entregues</span>
                        <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-600"></i>
                    </div>
                    <div class="text-2xl font-black text-emerald-600 mt-2" id="kpi-total-entregues">0</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Concluídos no destino</div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                        <span>Cavaletes a Coletar</span>
                        <i data-lucide="archive" class="w-4 h-4 text-amber-600"></i>
                    </div>
                    <div class="text-2xl font-black text-amber-600 mt-2" id="kpi-cavaletes-coletar">0</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Pendentes em clientes</div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                        <span>Lonas a Coletar</span>
                        <i data-lucide="file-text" class="w-4 h-4 text-brand-red"></i>
                    </div>
                    <div class="text-2xl font-black text-brand-red mt-2" id="kpi-lonas-coletar">0</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Logística reversa têxtil</div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                        <span>Cintas em Trânsito</span>
                        <i data-lucide="git-commit" class="w-4 h-4 text-indigo-600"></i>
                    </div>
                    <div class="text-2xl font-black text-indigo-600 mt-2" id="kpi-cintas-transito">0</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Em veículos ativos</div>
                </div>

                <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm">
                    <div class="flex items-center justify-between text-slate-500 text-xs font-medium">
                        <span>Trocas Motorista</span>
                        <i data-lucide="refresh-cw" class="w-4 h-4 text-purple-600"></i>
                    </div>
                    <div class="text-2xl font-black text-purple-600 mt-2" id="kpi-trocas-motorista">0</div>
                    <div class="text-[10px] text-slate-400 mt-0.5">Substituições operacionais</div>
                </div>
            </div>

            <!-- Dashboard Split View -->
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                <!-- Recent Orders Preview (2 cols) -->
                <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                    <div class="p-4 border-b border-slate-200 flex items-center justify-between">
                        <div class="flex items-center gap-2">
                            <i data-lucide="truck" class="w-5 h-5 text-brand-blue"></i>
                            <h3 class="font-bold text-sm text-navy-950">Últimos Pedidos Movimentados</h3>
                        </div>
                        <button onclick="switchTab('pedidos')" class="text-xs text-brand-blue hover:underline font-semibold">Ver Todos</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse text-xs">
                            <thead class="bg-slate-50 text-slate-500 font-semibold uppercase text-[10px] border-b border-slate-200">
                                <tr>
                                    <th class="p-3">Pedido</th>
                                    <th class="p-3">Cliente</th>
                                    <th class="p-3">Destino</th>
                                    <th class="p-3">Veículo</th>
                                    <th class="p-3">Placa / Motorista</th>
                                    <th class="p-3">Status</th>
                                    <th class="p-3 text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody id="dash-orders-tbody" class="divide-y divide-slate-100">
                                <tr><td colspan="7" class="p-8 text-center text-slate-400">Nenhum pedido cadastrado ainda. Clique em "+ Novo Pedido" para iniciar.</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Quick Actions & Reversible Summary (1 col) -->
                <div class="space-y-4">
                    <div class="bg-white p-5 rounded-xl border border-slate-200 shadow-sm space-y-3">
                        <h3 class="font-bold text-sm text-navy-950 flex items-center gap-2">
                            <i data-lucide="zap" class="w-4 h-4 text-amber-500"></i> Ações Rápidas
                        </h3>
                        <div class="grid grid-cols-1 gap-2">
                            <button onclick="openModal('modal-new-order')" class="w-full py-2.5 px-3 bg-brand-blue hover:bg-blue-700 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition shadow">
                                <i data-lucide="plus-circle" class="w-4 h-4"></i> Cadastrar Pedido / Carga
                            </button>
                            <button onclick="switchTab('solicitar-coleta')" class="w-full py-2.5 px-3 bg-navy-900 hover:bg-navy-800 text-white rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition">
                                <i data-lucide="map-pin" class="w-4 h-4 text-amber-400"></i> Solicitar Coleta com Rota GPS
                            </button>
                            <button onclick="openModal('modal-new-entrada')" class="w-full py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition">
                                <i data-lucide="arrow-down-left" class="w-4 h-4 text-emerald-600"></i> Receber Insumos ou Suprimentos
                            </button>
                            <button onclick="openModal('modal-new-saida')" class="w-full py-2.5 px-3 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-lg text-xs font-bold flex items-center justify-center gap-2 transition">
                                <i data-lucide="arrow-up-right" class="w-4 h-4 text-brand-red"></i> Despachar Saída / Descarte
                            </button>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-slate-900 to-navy-950 text-white p-5 rounded-xl border border-slate-800 shadow-sm space-y-3">
                        <h4 class="font-bold text-xs uppercase tracking-wider text-slate-400 flex items-center gap-2">
                            <i data-lucide="shield-alert" class="w-4 h-4 text-brand-red"></i> Conferência de Lacres
                        </h4>
                        <p class="text-xs text-slate-300 leading-relaxed">
                            Acesse a aba <strong>Estoque & Lacres</strong> para consultar o paradeiro de qualquer lacre individual e identificar em qual carga ou veículo ele se encontra.
                        </p>
                        <button onclick="switchTab('estoque')" class="w-full py-2 text-xs font-bold bg-white/10 hover:bg-white/20 text-white rounded-lg transition">
                            Rastrear Número de Lacre
                        </button>
                    </div>
                </div>
            </div>
        </section>

        <!-- ============================================================== -->
        <!-- TAB 2: PEDIDOS & CARGAS -->
        <!-- ============================================================== -->
        <section id="tab-pedidos" class="tab-content hidden space-y-4">
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex flex-col md:flex-row items-center justify-between gap-3">
                <div class="flex items-center gap-3 w-full md:w-auto">
                    <div class="relative w-full md:w-80">
                        <i data-lucide="search" class="w-4 h-4 absolute left-3 top-3 text-slate-400"></i>
                        <input type="text" id="filter-pedidos-search" oninput="renderOrdersTable()" placeholder="Buscar por pedido, cliente, lacre ou motorista..." class="w-full pl-9 pr-3 py-2 text-xs rounded-lg border border-slate-300 focus:ring-2 focus:ring-brand-blue focus:outline-none">
                    </div>
                    <select id="filter-pedidos-veiculo" onchange="renderOrdersTable()" class="text-xs py-2 px-3 rounded-lg border border-slate-300 bg-white">
                        <option value="">Todos os Veículos</option>
                        <option value="BITRUCK">Bitruck</option>
                        <option value="CARRETA">Carreta</option>
                    </select>
                </div>
                <div class="flex items-center gap-2 w-full md:w-auto justify-end">
                    <button onclick="openModal('modal-new-order')" class="px-3.5 py-2 text-xs font-bold bg-brand-blue hover:bg-blue-700 text-white rounded-lg flex items-center gap-1.5 shadow">
                        <i data-lucide="plus-circle" class="w-4 h-4"></i> Novo Pedido
                    </button>
                </div>
            </div>

            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead class="bg-slate-50 text-slate-600 font-bold uppercase text-[10px] border-b border-slate-200">
                            <tr>
                                <th class="p-3">Pedido</th>
                                <th class="p-3">UF</th>
                                <th class="p-3">Cliente / Destino</th>
                                <th class="p-3">Veículo</th>
                                <th class="p-3">Composição</th>
                                <th class="p-3">Lacres</th>
                                <th class="p-3">Placa & Motorista</th>
                                <th class="p-3">Status</th>
                                <th class="p-3 text-center">Ações</th>
                            </tr>
                        </thead>
                        <tbody id="orders-tbody" class="divide-y divide-slate-100">
                            <tr><td colspan="9" class="p-8 text-center text-slate-400">Nenhum pedido encontrado.</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <!-- ============================================================== -->
        <!-- TAB 3: COLETA REVERSA SEPARADA -->
        <!-- ============================================================== -->
        <section id="tab-coletas" class="tab-content hidden space-y-6">
            <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-sm flex items-center justify-between">
                <div>
                    <h2 class="text-base font-bold text-navy-950">Logística Reversa de Materiais</h2>
                    <p class="text-xs text-slate-500">Acompanhamento e baixa segregada de Cavaletes Metálicos versus Lonas & Forros/Cintas.</p>
                </div>
                <button onclick="switchTab('solicitar-coleta')" class="px-3 py-1.5 text-xs font-bold bg-amber-600 hover:bg-amber-700 text-white rounded-lg flex items-center gap-1.5 shadow">
                    <i data-lucide="map-pin" class="w-4 h-4"></i> Criar Ordem de Coleta para Frota
                </button>
            </div>

            <!-- Coleta Cavaletes Table -->
            <div class="bg-white rounded-xl border border-slate-200 shadow-sm overflow-hidden">
                <div class="p-4 bg-amber-50/60 border-b border-amber-200/80 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <i data-lucide="archive" class="w-5 h-5 text-amber-700"></i>
                        <h3 class="font-bold text-sm text-amber-950">1. Coleta de Cavaletes Metálicos</h3>
                    </div>
                    <span id="badge-total-cavaletes-pendentes" class="px-2.5 py-0.5 rounded-full text-xs font-bold bg-amber-200 text-amber-900">0 Pendentes</span>
                </div>
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead class="bg-slate-50 text-slate-600 font-semibold uppercase text-[10px] border-b border-slate-200">
                            <tr>
                                <th class="p-3">Pedido</th>
                                <th class="p-3">Cliente / Cidade</th>
                                <th class="p-3 text-center">Cavaletes Deixados</th>
                                <th class="p-3 text-center">Status Coleta</th>
