                    <td class="p-3 font-mono font-bold text-navy-950">${s.codigo}<br><span class="text-[10px] text-slate-400">${s.data}</span></td>
                    <td class="p-3 font-bold text-slate-800">${s.destino}</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-100 text-rose-800">${s.operacao}</span></td>
                    <td class="p-3 text-slate-800">${s.material}</td>
                    <td class="p-3 text-center font-bold text-brand-red">${s.quantidade}</td>
                    <td class="p-3 font-mono font-bold text-slate-700">${s.frota || '---'}</td>
                    <td class="p-3 text-slate-600">${s.responsavel}</td>
                    <td class="p-3 text-slate-600 text-[11px]">${s.motivo}</td>
                    <td class="p-3 text-center">
                        ${podeEditar() ? `
                        <button onclick="excluirSaida(${s.id})" class="p-1 rounded hover:bg-rose-100 text-rose-600" title="Excluir Saída">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>` : '—'}
                    </td>
                </tr>
            `).join('');
        }

        /* ==========================================================
           ESTOQUE — paginação (30 por página, até 30 páginas)
           ========================================================== */
        const ESTOQUE_POR_PAGINA = 30;
        const ESTOQUE_MAX_PAGINAS = 30;
        let estoquePagina = 1;

        function totalPaginasEstoque() {
            const total = db.estoqueLacres.length;
            const paginas = Math.ceil(total / ESTOQUE_POR_PAGINA) || 1;
            return Math.min(paginas, ESTOQUE_MAX_PAGINAS);
        }

        function irParaPaginaEstoque(delta) {
            const alvo = estoquePagina + delta;
            const max = totalPaginasEstoque();
            if (alvo < 1 || alvo > max) return;
            estoquePagina = alvo;
            renderEstoqueTable();
        }

        function irParaPaginaEstoqueNumero(n) {
            const max = totalPaginasEstoque();
            if (n < 1 || n > max) return;
            estoquePagina = n;
            renderEstoqueTable();
        }

        /* ==========================================================
           PAINEL DE CINTAS
           ========================================================== */
        function renderCintas() {
            const c = db.cintas || { novas: 0, usadas: 0 };
            const elN = document.getElementById('cintas-novas');
            const elU = document.getElementById('cintas-usadas');
            if (elN) elN.textContent = c.novas;
            if (elU) elU.textContent = c.usadas;

            const badge = document.getElementById('cintas-total-badge');
            if (badge) badge.textContent = `total ${c.novas + c.usadas}`;

            // botão de ajuste só para admin
            const btn = document.getElementById('btn-ajustar-cintas');
            if (btn) btn.style.display = podeEditar() ? '' : 'none';

            // Aviso visível quando o recurso não está disponível.
            const aviso = document.getElementById('cintas-aviso');
            if (aviso) {
                if (db.cintasErro) {
                    aviso.textContent = db.cintasErro;
                    aviso.classList.remove('hidden');
                } else {
                    aviso.classList.add('hidden');
                }
            }

            const lista = document.getElementById('cintas-movimentos');
            if (!lista) return;

            const movs = c.movimentos || db.cintasMovimentos || [];
            if (!movs.length) {
                lista.innerHTML = `<li class="text-slate-400">Sem movimentações registradas.</li>`;
                return;
            }

            const cor = (tipo) => {
                if (tipo.includes('Saída')) return 'text-blue-700';
                if (tipo.includes('Devolução')) return 'text-amber-700';
                if (tipo.includes('Coleta')) return 'text-emerald-700';
                return 'text-slate-600';
            };

            lista.innerHTML = movs.slice(0, 40).map(m => {
                const sinal = m.quantidade > 0 ? '+' : '';
                const q = `${sinal}${m.quantidade}`;
                return `
                    <li class="flex items-start gap-2 py-1 border-b border-slate-100 last:border-0">
                        <span class="px-1.5 py-0.5 rounded text-[9px] font-bold shrink-0 ${
                            m.condicao === 'Nova' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800'
                        }">${m.condicao}</span>
                        <div class="flex-1 min-w-0">
                            <span class="font-bold ${cor(m.tipo)} text-[10px]">${m.tipo}</span>
                            <span class="text-[10px] text-slate-500"> • ${m.pedido ? 'pedido ' + m.pedido : (m.cliente || '')}</span>
                            <p class="text-[10px] text-slate-500 truncate">${m.detalhes || ''}</p>
                        </div>
                        <div class="text-right shrink-0">
                            <span class="font-mono font-bold text-[11px] ${m.quantidade > 0 ? 'text-emerald-700' : 'text-rose-600'}">${q}</span>
                            <span class="block text-[9px] text-slate-400">saldo ${m.saldo}</span>
                        </div>
                    </li>`;
            }).join('');
        }

        function abrirModalAjusteCintas() {
            if (!podeEditar()) {
                alert('Somente o administrador pode ajustar o estoque.\n\n' +
                      'Se você é o administrador, confira se entrou com o e-mail correto.');
                return;
            }
            if (!CINTAS_DISPONIVEL) {
                alert('O controle de cintas ainda não está ativo neste banco.\n\n' +
                      'Rode o script 05_cintas_nova_usada.sql no Editor SQL do Supabase ' +
                      'e recarregue a página.');
                return;
            }
            const c = db.cintas || { novas: 0, usadas: 0 };
            document.getElementById('ajuste-cintas-novas').value = c.novas;
            document.getElementById('ajuste-cintas-usadas').value = c.usadas;
            document.getElementById('ajuste-cintas-motivo').value = '';
            openModal('modal-ajuste-cintas');
        }

        async function salvarAjusteCintas(e) {
            e.preventDefault();
            if (!podeEditar()) { alert('Somente o administrador pode ajustar o estoque.'); return; }

            const novas  = Number(document.getElementById('ajuste-cintas-novas').value);
            const usadas = Number(document.getElementById('ajuste-cintas-usadas').value);
            const motivo = document.getElementById('ajuste-cintas-motivo').value.trim();

            try {
                await ajustarCintasNoBanco('Nova',  novas,  motivo);
                await ajustarCintasNoBanco('Usada', usadas, motivo);
            } catch (err) {
                const msg = mensagemErro(err);
                console.error('Erro ao ajustar cintas:', msg);
                if (/ajustar_cintas|does not exist|42883/i.test(msg)) {
                    alert('O controle de cintas não está ativo neste banco.\n\n' +
                          'Rode o script 05_cintas_nova_usada.sql no Editor SQL do Supabase.');
                } else if (/Acesso restrito|42501/i.test(msg)) {
                    alert('Seu usuário não tem permissão de administrador neste banco.\n\n' +
                          'Confira em Authentication → Users se o seu perfil tem papel = admin.');
                } else {
                    alert('Não foi possível ajustar: ' + msg);
                }
                return;
            }

            await recarregarCintas();
            closeModal('modal-ajuste-cintas');
            showToast('Estoque de cintas atualizado.');
        }

        let CINTAS_DISPONIVEL = false;

        async function recarregarCintas() {
            try {
                const { data, error } = await sb.rpc('estoque_cintas');
                if (error) throw error;
                if (data) {
                    db.cintas = { novas: data.novas, usadas: data.usadas };
                    db.cintasMovimentos = data.movimentos || [];
                    CINTAS_DISPONIVEL = true;
                }
            } catch (err) {
                const msg = mensagemErro(err);
                CINTAS_DISPONIVEL = false;
                console.error('Erro ao carregar cintas:', msg);

                // Se a função não existe, o script 05 não foi rodado no banco.
                if (/estoque_cintas|does not exist|42883/i.test(msg)) {
                    db.cintas = { novas: 0, usadas: 0 };
                    db.cintasErro = 'O controle de cintas ainda não está ativo neste banco. Rode o script 05_cintas_nova_usada.sql no Supabase.';
                } else {
                    db.cintasErro = msg;
                }
            }
            renderCintas();
        }

        // Extrai uma mensagem legível do erro que vem do Supabase/PostgREST.
        function mensagemErro(err) {
            if (!err) return 'Erro desconhecido';
            if (typeof err === 'string') return err;
            const partes = [err.message, err.details, err.hint].filter(Boolean);
            return partes.length ? partes.join(' — ') : String(err);
        }

        function renderEstoqueTable() {
            const tbody = document.getElementById('estoque-tbody');
            const total = db.estoqueLacres.length;

            if (!total) {
                tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400">Nenhum lacre cadastrado.</td></tr>`;
                document.getElementById('estoque-pagina-info').textContent = '';
                document.getElementById('estoque-pagina-atual').textContent = '';
                document.getElementById('estoque-btn-anterior').disabled = true;
                document.getElementById('estoque-btn-proxima').disabled = true;
                return;
            }

            const maxPaginas = totalPaginasEstoque();

            // Se o filtro/recarga reduziu a lista, volta para uma página válida.
            if (estoquePagina > maxPaginas) estoquePagina = maxPaginas;
            if (estoquePagina < 1) estoquePagina = 1;

            const inicio = (estoquePagina - 1) * ESTOQUE_POR_PAGINA;
            const fim = inicio + ESTOQUE_POR_PAGINA;
            const itens = db.estoqueLacres.slice(inicio, fim);

            tbody.innerHTML = itens.map(item => `
                <tr class="hover:bg-slate-50 border-b border-slate-100">
                    <td class="p-3 font-semibold text-slate-800">${item.material}</td>
                    <td class="p-3 font-mono font-bold text-navy-950">#${item.lacre}</td>
                    <td class="p-3 text-slate-600">${item.situacao}</td>
                    <td class="p-3"><span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${item.status === 'Disponível no Galpão' ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800'}">${item.status}</span></td>
                    <td class="p-3 font-mono text-slate-700">${item.placa}</td>
                    <td class="p-3 text-slate-500 text-[11px]">${item.data}</td>
                    <td class="p-3 text-center">
                        ${podeEditar() && item.id ? `
                        <button onclick="excluirLacreEstoque(${item.id})" class="p-1 rounded hover:bg-rose-100 text-rose-600" title="Remover do Estoque">
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>` : '—'}
                    </td>
                </tr>
            `).join('');

            // Informação de faixa + aviso quando há mais registros do que 900
            let info = `Mostrando ${inicio + 1}–${Math.min(fim, total)} de ${total} itens`;
            if (total > ESTOQUE_POR_PAGINA * ESTOQUE_MAX_PAGINAS) {
                info += ` • exibindo até ${ESTOQUE_POR_PAGINA * ESTOQUE_MAX_PAGINAS}`;
            }
            document.getElementById('estoque-pagina-info').textContent = info;
            document.getElementById('estoque-pagina-atual').textContent = `${estoquePagina} / ${maxPaginas}`;
            document.getElementById('estoque-btn-anterior').disabled = estoquePagina <= 1;
            document.getElementById('estoque-btn-proxima').disabled = estoquePagina >= maxPaginas;
        }

        function renderHistoricoTable() {
            const tbody = document.getElementById('historico-tbody');
            if (!db.historico.length) {
                tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400">Nenhum registro no histórico.</td></tr>`;
                return;
            }

            tbody.innerHTML = db.historico.map(h => `
                <tr class="hover:bg-slate-50 border-b border-slate-100">
                    <td class="p-3 font-mono text-[11px] text-slate-500">${h.data}</td>
                    <td class="p-3">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold ${
                            h.tipo.includes('Troca') ? 'bg-purple-100 text-purple-800' :
                            h.tipo.includes('Entrada') ? 'bg-emerald-100 text-emerald-800' :
                            h.tipo.includes('Coleta') ? 'bg-amber-100 text-amber-800' : 'bg-blue-100 text-blue-800'
                        }">
                            ${h.tipo}
                        </span>
                    </td>
                    <td class="p-3 font-mono font-bold text-navy-950">#${h.pedido}</td>
                    <td class="p-3 text-slate-800 font-medium">${h.detalhes}</td>
                    <td class="p-3 font-mono text-[11px] text-slate-600">${h.lacrePlaca}</td>
                    <td class="p-3 text-slate-600 text-[11px]">${h.obs}</td>
                </tr>
            `).join('');
        }

        /* ==========================================================
           INICIALIZAÇÃO DA APLICAÇÃO
           ========================================================== */
        // Registra o service worker: deixa o app instalável e abrindo
        // sem internet. Só funciona em https (ou localhost).
        /* -----------------------------------------------------------------
           Instalar como app

           O navegador avisa quando o app pode ser instalado (evento
           beforeinstallprompt). Guardamos esse aviso e só mostramos o
           botão quando ele existe — em navegador que não suporta, o
           botão simplesmente não aparece.
           ----------------------------------------------------------------- */
        let PROMPT_INSTALAR = null;

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            PROMPT_INSTALAR = e;
            const btn = document.getElementById('btn-instalar-app');
            if (btn) btn.classList.remove('hidden');
        });

        window.addEventListener('appinstalled', () => {
            PROMPT_INSTALAR = null;
            const btn = document.getElementById('btn-instalar-app');
            if (btn) btn.classList.add('hidden');
            showToast('LogiTrack instalado! Procure o ícone na tela inicial.');
        });

        async function instalarApp() {
            if (!PROMPT_INSTALAR) {
                // Sem o aviso do navegador: ensina o caminho manual
                alert(
                    'Para instalar o LogiTrack:\n\n' +
                    '• No Android (Chrome): menu ⋮ → "Instalar app" ou "Adicionar à tela inicial".\n\n' +
                    '• No iPhone (Safari): botão Compartilhar → "Adicionar à Tela de Início".\n\n' +
                    '• No computador (Chrome/Edge): ícone de instalar na barra de endereço.'
                );
                return;
            }

            PROMPT_INSTALAR.prompt();
            const escolha = await PROMPT_INSTALAR.userChoice;
            if (escolha.outcome === 'accepted') {
                showToast('Instalando...');
            }
            PROMPT_INSTALAR = null;
            const btn = document.getElementById('btn-instalar-app');
            if (btn) btn.classList.add('hidden');
        }

        function registrarServiceWorker() {
            if (!('serviceWorker' in navigator)) return;
            if (location.protocol === 'file:') return;

            navigator.serviceWorker.register('sw.js', { scope: './' })
                .then(() => console.log('App pronto para uso offline.'))
                .catch((e) => console.warn('Service worker não registrou:', e));
        }

        window.addEventListener('DOMContentLoaded', async () => {
            const formUsuario = document.getElementById('form-novo-usuario');
            if (formUsuario) formUsuario.addEventListener('submit', salvarNovoUsuario);

            aplicarLogoGlobal();
            registrarServiceWorker();
            iniciarModoOffline();

            // 1. O banco está configurado? Se não, pede a configuração.
            if (!conectarBanco()) {
                mostrarTelaConfig();
                return;
            }

            // 2. Link do motorista tem prioridade: NÃO pede login.
            const token = extrairTokenDaUrl();

            if (token) {
                await abrirPortalPorToken(token);
                return;
            }

            // 3. Equipe: login normal
            const logado = await iniciarSessao();
            if (!logado) return;

            await iniciarAplicacao();
        });
    </script>
