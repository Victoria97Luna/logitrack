        /* ==========================================================
           REGRAS AUTOMÁTICAS DE VEÍCULO (BITRUCK VS CARRETA)
           ========================================================== */
        function aoMudarTipoVeiculo(tipo) {
            const isCarreta = tipo === 'CARRETA';
            const cLona2 = document.getElementById('container-lacre-lona-2');
            const cForro2 = document.getElementById('container-lacre-forro-2');
            const inLona2 = document.getElementById('new-lacre-lona-2');
            const inForro2 = document.getElementById('new-lacre-forro-2');

            // Os cavaletes definem lonas, forros e cintas — sempre.
            const elCav = document.getElementById('new-qtd-cavaletes');
            const elNova = document.getElementById('new-qtd-cintas-novas');
            const elUsada = document.getElementById('new-qtd-cintas-usadas');

            if (isCarreta) {
                cLona2.classList.remove('hidden');
                cForro2.classList.remove('hidden');
                inLona2.setAttribute('required', 'required');
                inForro2.setAttribute('required', 'required');

                // carreta padrão: 2 cavaletes (o operador pode aumentar
                // para bitrem/bitruck maior, que é a exceção)
                if (elCav) elCav.value = 2;
                if (elUsada) elUsada.value = 0;
                if (elNova) elNova.value = 2 * CINTAS_POR_CAVALETE;
            } else {
                cLona2.classList.add('hidden');
                cForro2.classList.add('hidden');
                inLona2.removeAttribute('required');
                inForro2.removeAttribute('required');
                inLona2.value = '';
                inForro2.value = '';

                if (elCav) elCav.value = 1;
                if (elUsada) elUsada.value = 0;
                if (elNova) elNova.value = CINTAS_POR_CAVALETE;
            }

            aplicarRegraCavaletes();
            atualizarTotaisCintas();
        }

        function aoMudarTipoMaterialEntrada(tipo) {
            const cOutros = document.getElementById('container-entrada-outros-desc');
            const inOutros = document.getElementById('entrada-outros-desc');
            if (tipo === 'Outros') {
                cOutros.classList.remove('hidden');
                inOutros.setAttribute('required', 'required');
            } else {
                cOutros.classList.add('hidden');
                inOutros.removeAttribute('required');
            }
        }

        /* ==========================================================
           CADASTRO DE NOVO PEDIDO
           ========================================================== */
        /* ==========================================================
           CINTAS — controle por quantidade (nova x usada)
           ========================================================== */
        /* ==========================================================
           REGRA DOS CAVALETES

           1 cavalete SEMPRE leva:
             1 lona + 1 forro + 4 cintas

           Então o número de cavaletes manda em tudo:
             1 cav -> 1 lona, 1 forro,  4 cintas   (bitruck)
             2 cav -> 2 lonas, 2 forros, 8 cintas  (carreta)
             3 cav -> 3 lonas, 3 forros, 12 cintas (bitrem — excepcional)

           Passar de 2 cavaletes é situação RARA: aparece um aviso para
           ninguém cadastrar bitrem por engano.
           ========================================================== */

        const CINTAS_POR_CAVALETE = 4;
        const CAVALETES_MAX_NORMAL = 2;

        // Recalcula lonas, forros e o total de cintas a partir dos cavaletes.
        function aplicarRegraCavaletes() {
            const elCav = document.getElementById('new-qtd-cavaletes');
            if (!elCav) return;

            let cav = parseInt(elCav.value, 10);
            if (!Number.isFinite(cav) || cav < 1) cav = 1;

            // trava o campo, para o valor não virar lixo (ex.: 1.5)
            if (elCav.value !== String(cav)) elCav.value = cav;

            const lonas  = cav;
            const forros = cav;
            const cintas = cav * CINTAS_POR_CAVALETE;

            const elLon = document.getElementById('new-qtd-lonas');
            const elFor = document.getElementById('new-qtd-forros');
            if (elLon) elLon.value = lonas;
            if (elFor) elFor.value = forros;

            // cintas: mantém a proporção nova/usada e ajusta o total
            const elNova = document.getElementById('new-qtd-cintas-novas');
            const elUsada = document.getElementById('new-qtd-cintas-usadas');
            if (elNova) {
                let n = parseInt(elNova.value, 10);
                let u = elUsada ? parseInt(elUsada.value, 10) : 0;
                if (!Number.isFinite(n)) n = 0;
                if (!Number.isFinite(u)) u = 0;

                // se o usuário ainda não mexeu, joga tudo como nova
                if (n + u !== cintas) {
                    // mantém as usadas se couberem, o resto vira nova
                    u = Math.min(u, cintas);
                    n = cintas - u;
                    if (elUsada) elUsada.value = u;
                }
                elNova.value = n;
                atualizarTotaisCintas();
            }

            // aviso de carga excepcional
            const aviso = document.getElementById('aviso-cavaletes-excecao');
            if (aviso) aviso.classList.toggle('hidden', cav <= CAVALETES_MAX_NORMAL);
        }

        function atualizarTotaisCintas() {
            const n = Number(document.getElementById('new-qtd-cintas-novas')?.value || 0);
            const u = Number(document.getElementById('new-qtd-cintas-usadas')?.value || 0);
            const tot = document.getElementById('new-cintas-total');
            if (tot) tot.textContent = (n + u);

            const saldoEl = document.getElementById('new-cintas-saldo');
            if (saldoEl && db.cintas) {
                saldoEl.textContent = `Estoque: ${db.cintas.novas} novas • ${db.cintas.usadas} usadas`;
                // avisa se está pedindo mais do que tem
                const faltaN = n > db.cintas.novas;
                const faltaU = u > db.cintas.usadas;
                saldoEl.className = 'text-[10px] font-bold ' +
                    (faltaN || faltaU ? 'text-rose-600' : 'text-indigo-700');
                if (faltaN || faltaU) {
                    saldoEl.textContent += ' — acima do disponível';
                }
            }
        }

        /* ----------------------------------------------------------
           Endereço é obrigatório de verdade.
           Não basta o "required" do HTML: um espaço, um traço ou
           "não sei" passariam. Aqui exige rua com número e bairro.
           ---------------------------------------------------------- */
        function validarEndereco(endereco, cidade, uf) {
            const txt = String(endereco || '').trim();

            if (!txt) {
                return 'O endereço é obrigatório. Sem ele o motorista não chega e o mapa não é gerado.';
            }
            if (txt.length < 10) {
                return 'Endereço incompleto. Informe rua, número e bairro.';
            }
            // precisa de um número (o do imóvel) para o GPS achar o ponto
            if (!/\d/.test(txt)) {
                return 'Falta o número do imóvel no endereço. Ex.: Av. Rio Verde, 1200 - Vila Rosa.';
            }
            if (!cidade || !String(cidade).trim()) {
                return 'A cidade é obrigatória — é por ela que a rota é montada.';
            }
            if (!uf || !String(uf).trim()) {
                return 'O estado (UF) é obrigatório.';
            }
            return null;
        }

        function mostrarErroEndereco(msg) {
            const el = document.getElementById('new-endereco-erro');
            const campo = document.getElementById('new-endereco');
            if (!el) return;
            if (msg) {
                el.textContent = msg;
                el.classList.remove('hidden');
                if (campo) {
                    campo.classList.add('border-rose-500');
                    campo.focus();
                }
            } else {
                el.classList.add('hidden');
                if (campo) campo.classList.remove('border-rose-500');
            }
        }

        async function handleSalvarNovoPedido(e) {
            e.preventDefault();
            const veiculo = document.getElementById('new-veiculo').value;
            const pedidoNum = document.getElementById('new-numero-pedido').value.trim();

            // ---- endereço: barra antes de tentar gravar ----
