        function enviarLinkWhatsApp(ordemId) {
            const ordem = db.ordensColeta.find(o => o.id === ordemId);
            if (!ordem) return;

            // Prefere a rota detalhada (com quantidades por parada);
            // se ainda não houver, cai no retrato de clientes da ordem.
            const paradas = ordem.paradas || ordem.itens || [];
            const pedidos = db.pedidos.filter(p => (ordem.pedidosIds || []).includes(p.id));
            const locais = paradas.length
                ? paradas.map((x, idx) => ({
                      ordem: x.parada || idx + 1,
                      cliente: x.cliente,
                      endereco: x.endereco || '',
                      maps: x.maps || '',
                      cav: x.prevCavaletes ?? 0,
                      lon: x.prevLonas ?? 0,
                      forr: x.prevForros ?? 0,
                      cin: x.prevCintas ?? 0
                  }))
                : (pedidos.length ? pedidos : (ordem.clientesSnapshot || [])).map((x, idx) => ({
                      ordem: idx + 1,
                      cliente: x.cliente,
                      endereco: x.endereco || '',
                      maps: '',
                      cav: x.coletaCavaletePendente ? (x.cavaletes ?? 0) : 0,
                      lon: x.coletaLonaPendente ? (x.lonas ?? 0) : 0,
                      forr: x.coletaLonaPendente ? (x.forros ?? 0) : 0,
                      cin: x.coletaLonaPendente ? (x.cintas ?? 0) : 0
                  }));

            let listaLocais = '';
            if (locais.length) {
                listaLocais = locais.map(p => {
                    let bloco = `📍 *Parada ${p.ordem}: ${p.cliente}*%0A` +
                                `🏢 ${p.endereco}%0A` +
                                `📦 ${p.cav} cavalete(s), ${p.lon} lona(s), ${p.forr} forro(s), ${p.cin} cinta(s)%0A`;
                    if (p.maps) bloco += `🗺️ ${p.maps}%0A`;
                    return bloco;
                }).join('%0A');
            } else {
                listaLocais = `📍 *Clientes designados para a ordem ${ordem.codigo}*%0A`;
            }

            // Link por token: nada de dados do cliente viajam na URL.
            // O banco valida o token (7 dias, revogável).
            if (!ordem.token) {
                alert('Esta ordem não tem link válido. Gere a ordem novamente.');
                return;
            }

            const baseHref = window.location.href.split('#')[0].split('?')[0];
            const linkPortal = `${baseHref}#coleta=${ordem.token}`;

            // Mensagem direta com nome, endereço e link clicável isolado
            const tCav = paradas.length ? paradas.reduce((a, x) => a + (x.prevCavaletes ?? 0), 0) : (ordem.previstoCavaletes ?? 0);
            const tLon = paradas.length ? paradas.reduce((a, x) => a + (x.prevLonas ?? 0), 0) : null;
            const tFor = paradas.length ? paradas.reduce((a, x) => a + (x.prevForros ?? 0), 0) : null;
            const tCin = paradas.length ? paradas.reduce((a, x) => a + (x.prevCintas ?? 0), 0) : (ordem.previstoCintas ?? 0);

            const linhaTotais = (tLon !== null)
                ? `${tCav} cavalete(s), ${tLon} lona(s), ${tFor} forro(s), ${tCin} cinta(s)`
                : `${tCav} cavalete(s), ${ordem.previstoKits} kit(s) lona, ${tCin} cinta(s)`;

            const linkRota = ordem.linkRota
                ? `🗺️ *ROTA COMPLETA NO MAPS:*%0A${ordem.linkRota}%0A%0A`
                : '';

            const msg = `*SOLICITAÇÃO DE COLETA REVERSA (${ordem.codigo})*%0A%0A` +
                        `🚛 *Frota:* ${ordem.frota}%0A` +
                        `📍 *Paradas:* ${paradas.length || locais.length}%0A` +
                        `📦 *Materiais Previstos:* ${linhaTotais}%0A%0A` +
                        `📋 *LOCAIS DE COLETA:*%0A%0A` +
                        listaLocais + `%0A` + linkRota +
                        `🔗 *CLIQUE NO LINK ABAIXO PARA CONFIRMAR A COLETA:*%0A` +
                        `${linkPortal}%0A%0A` +
                        `_Abra o link acima para informar as quantidades coletadas e dar baixa no sistema._`;

            window.open(`https://api.whatsapp.com/send?text=${msg}`, '_blank');
        }

