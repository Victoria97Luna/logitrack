            if (veiculo === 'CARRETA') lacresForro.push(document.getElementById('new-lacre-forro-2').value.trim());

            const novoPedido = {
                id: Date.now(),
                numero: pedidoNum,
                cliente: document.getElementById('new-cliente').value.trim(),
                cidade: cidadeDigitada,
                uf: ufDigitada,
                endereco: enderecoDigitado,
                veiculo: veiculo,
                placa: document.getElementById('new-placa').value.trim().toUpperCase(),
                motorista: document.getElementById('new-motorista').value.trim(),
                data: document.getElementById('new-data').value,
                horario: document.getElementById('new-horario').value,
                cavaletes: Number(document.getElementById('new-qtd-cavaletes').value),
