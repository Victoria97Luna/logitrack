        /* ==========================================================
           IMPORTAÇÃO EXCEL
           Lê: nº do pedido, lona, forro, cinta, cidade, estado,
           endereço e nome do motorista.
           Aceita cabeçalhos com nomes variados (com/sem acento).
           ========================================================== */

        // normaliza um cabeçalho: minúsculo, sem acento, sem pontuação
        function normalizarCabecalho(txt) {
            return String(txt || '')
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .toLowerCase()
                .replace(/[^a-z0-9]+/g, ' ')
                .trim();
        }

        // procura o valor de uma coluna, testando vários nomes possíveis
        function lerCampo(row, nomes) {
            const mapa = {};
            Object.keys(row).forEach(k => { mapa[normalizarCabecalho(k)] = row[k]; });

            for (const nome of nomes) {
                const alvo = normalizarCabecalho(nome);
                if (mapa[alvo] !== undefined && mapa[alvo] !== null && String(mapa[alvo]).trim() !== '') {
                    return mapa[alvo];
                }
            }
            // segunda passada: casa por "contém", para pegar variações
            for (const nome of nomes) {
                const alvo = normalizarCabecalho(nome);
                for (const chave of Object.keys(mapa)) {
                    const v = mapa[chave];
                    if (chave.includes(alvo) && v !== undefined && v !== null && String(v).trim() !== '') {
                        return v;
                    }
                }
            }
            return null;
        }

        // números podem vir como "2", "2,5" ou "2 un"
        function lerNumero(valor, padrao) {
            if (valor === null || valor === undefined) return padrao;
            const n = parseInt(String(valor).replace(/[^\d-]/g, ''), 10);
            return Number.isFinite(n) ? n : padrao;
        }

        function lerLacres(valor) {
            if (valor === null || valor === undefined) return [];
            return String(valor).split(/[\s,;\/|]+/).map(t => t.trim()).filter(Boolean);
        }

        /* ------------------------------------------------------------------
           IMPORTAÇÃO DE EXCEL

           A planilha do Fernando tem três abas — Cadastro, Estoque e Kits —
           e o cabeçalho não cai sempre na mesma linha. Por isso a leitura
           aqui:
             • varre TODAS as abas (não só "Kits");
             • procura a linha de cabeçalho nas primeiras 30 linhas;
             • junta os pedidos das abas que tiverem número de pedido;
             • mostra o que encontrou e o que ignorou antes de gravar.
           ------------------------------------------------------------------ */

        const PALAVRAS_CABECALHO = [
            'pedido', 'cliente', 'lona', 'forro', 'cinta', 'cidade',
            'estado', 'uf', 'endereco', 'motorista', 'placa', 'lacre'
        ];

        // Descobre em qual linha está o cabeçalho, comparando quantas
        // palavras conhecidas aparecem nela.
        function acharLinhaCabecalho(matriz) {
            let melhorLinha = 0;
            let melhorPontos = -1;

            for (let i = 0; i < Math.min(matriz.length, 30); i++) {
                const celulas = (matriz[i] || [])
                    .map(normalizarCabecalho)
                    .filter(Boolean);

                const pontos = celulas.filter(c =>
                    PALAVRAS_CABECALHO.some(p => c.includes(p))
                ).length;

                if (pontos > melhorPontos) {
                    melhorPontos = pontos;
                    melhorLinha = i;
                }
            }
            return { linha: melhorLinha, pontos: melhorPontos };
        }

        // Uma aba "serve" se o cabeçalho tem número de pedido E pelo menos
        // mais um campo reconhecido. Evita importar aba de estoque puro.
        function abaTemPedidos(matriz) {
            const { linha, pontos } = acharLinhaCabecalho(matriz);
            if (pontos < 2) return null;

            const cabecalho = (matriz[linha] || []).map(normalizarCabecalho);
            const temNumero = cabecalho.some(c =>
                c.includes('pedido') || c === 'numero' || c.includes('n do pedido')
            );
            if (!temNumero) return null;

            return { linha, pontos };
        }

        function dataDeExcel(valor) {
            if (!valor) return new Date().toISOString().split('T')[0];

            if (typeof valor === 'number') {
                const ms = Math.round((valor - 25569) * 86400 * 1000);
                const d = new Date(ms);
                if (!isNaN(d)) return d.toISOString().split('T')[0];
            }
            if (valor instanceof Date && !isNaN(valor)) {
                return valor.toISOString().split('T')[0];
            }

            const s = String(valor).trim();
            const br = s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{2,4})$/);
            if (br) {
                const ano = br[3].length === 2 ? '20' + br[3] : br[3];
                return `${ano}-${br[2].padStart(2, '0')}-${br[1].padStart(2, '0')}`;
            }
            const iso = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
            if (iso) return `${iso[1]}-${iso[2]}-${iso[3]}`;

            const d = new Date(s);
            if (!isNaN(d)) return d.toISOString().split('T')[0];

            return new Date().toISOString().split('T')[0];
        }

        // Converte uma linha da planilha em um pedido do sistema.
        function linhaParaPedido(row, aba) {
            const numero = lerCampo(row, [
                'Nº do Pedido', 'No do Pedido', 'Numero do Pedido', 'Número do Pedido',
                'Pedido', 'Nº Pedido', 'No Pedido', 'Número', 'Numero'
            ]);
            if (!numero || String(numero).trim() === '') return null;
            // (o endereço é conferido logo abaixo, junto com o resto)

            const cidade  = lerCampo(row, ['Cidade', 'Municipio', 'Município']);
            const estado  = lerCampo(row, ['Estado', 'UF', 'Uf', 'Estado (UF)']);
            const uf      = estado ? String(estado).trim().toUpperCase().slice(0, 2) : 'SP';
            const cliente = lerCampo(row, ['Nome do Cliente', 'Cliente', 'Razao Social', 'Razão Social']);
            const endereco = lerCampo(row, [
                'Endereço', 'Endereco', 'Logradouro', 'Rua', 'Local', 'Local de Coleta'
            ]);

            // Endereço é obrigatório: não inventa mais um "endereço"
            // com o nome do cliente. Se a linha não trouxer endereço
            // com número, ela é reportada e não entra.
            const enderecoFinal = endereco ? String(endereco).trim() : '';
            if (!enderecoFinal || !/\d/.test(enderecoFinal) || enderecoFinal.length < 10) return null;

            const veiculoTxt = lerCampo(row, ['Veículo', 'Veiculo', 'Tipo de Veiculo', 'Tipo de Veículo']);
            const veiculo = veiculoTxt && String(veiculoTxt).toUpperCase().includes('CARRETA')
                ? 'CARRETA' : 'BITRUCK';

            return {
                numero: String(numero).trim(),
                cliente: cliente ? String(cliente).trim()
                                 : (cidade ? `Cliente ${cidade}` : 'Cliente'),
                cidade: cidade ? String(cidade).trim() : '---',
                uf: uf,
                endereco: enderecoFinal,
                veiculo: veiculo,
                placa: (() => {
                    const pl = lerCampo(row, ['Placa', 'Placa do Veiculo', 'Placa do Veículo']);
                    return pl ? String(pl).trim().toUpperCase() : '';
                })(),
                motorista: (() => {
                    const m = lerCampo(row, ['Nome do Motorista', 'Motorista', 'Condutor', 'Nome do Condutor']);
                    return m ? String(m).trim() : 'Motorista Designado';
                })(),
                data: dataDeExcel(lerCampo(row, ['Data', 'Data do Pedido', 'Data da Carga'])),
                horario: '08:00',
                cavaletes: lerNumero(lerCampo(row, ['Cavaletes', 'Cavalete', 'Qtd Cavaletes', 'Qtde Cavaletes']), 1),
                lonas:     lerNumero(lerCampo(row, ['Lonas', 'Lona', 'Qtd Lonas', 'Qtde Lonas', 'Kits (Lonas)']), 1),
                forros:    lerNumero(lerCampo(row, ['Forros', 'Forro', 'Qtd Forros', 'Qtde Forros']), 1),
                cintas:    lerNumero(lerCampo(row, ['Cintas', 'Cinta', 'Cintas Catraca', 'Qtd Cintas', 'Qtde Cintas']), 4),
                lacresLona:  lerLacres(lerCampo(row, ['Lacre Lona', 'Lacres Lona', 'Lacre da Lona', 'Lacre Lonas', 'Lacre de Lona'])),
                lacresForro: lerLacres(lerCampo(row, ['Lacre Forro', 'Lacres Forro', 'Lacre do Forro', 'Lacre Forros', 'Lacre de Forro'])),
                entregue: false,
                coletaCavaletePendente: true,
                coletaLonaPendente: true
            };
        }

        // Lê o arquivo inteiro e devolve os pedidos de todas as abas.
        function lerPlanilhaCompleta(workbook) {
            const pedidos = [];
            const relatorio = [];
            const vistos = new Set();

            (workbook.SheetNames || []).forEach(nomeAba => {
                const sheet = workbook.Sheets[nomeAba];
                if (!sheet) return;

                // blankrows: true mantém o índice da matriz igual ao da planilha
                const matriz = XLSX.utils.sheet_to_json(sheet, {
                    header: 1, blankrows: true, defval: null
                });
                if (!matriz.length) {
                    relatorio.push({ aba: nomeAba, status: 'vazia', lidos: 0 });
                    return;
                }

                const cab = abaTemPedidos(matriz);
                if (!cab) {
                    relatorio.push({ aba: nomeAba, status: 'sem pedidos', lidos: 0 });
                    return;
                }

                const linhas = XLSX.utils.sheet_to_json(sheet, {
                    range: cab.linha, blankrows: false, defval: null
                });

                let lidos = 0;
                let semEndereco = 0;

                linhas.forEach((row, idx) => {
                    // número do pedido antes de tudo, para saber se a linha conta
                    const numero = lerCampo(row, [
                        'Nº do Pedido', 'No do Pedido', 'Numero do Pedido', 'Número do Pedido',
                        'Pedido', 'Nº Pedido', 'No Pedido', 'Número', 'Numero'
                    ]);
                    if (!numero || String(numero).trim() === '') return;

                    const pedido = linhaParaPedido(row, nomeAba);
                    if (!pedido) {
                        // tinha número mas o endereço não serve: conta e reporta
                        semEndereco++;
                        return;
                    }

                    // mesmo número em outra aba: fica o primeiro
                    if (vistos.has(pedido.numero)) return;
                    vistos.add(pedido.numero);

                    pedidos.push(pedido);
                    lidos++;
                });

                relatorio.push({
                    aba: nomeAba, status: 'ok', lidos,
                    semEndereco,
                    cabecalhoNaLinha: cab.linha + 1
                });
            });

            return { pedidos, relatorio };
        }

        async function processarArquivoExcel(event) {
            const input = event.target;
            const file = input.files[0];
            if (!file) return;

            // permite escolher o mesmo arquivo de novo depois de um erro
            input.value = '';

            const reader = new FileReader();
            reader.onerror = () => alert('Não foi possível ler o arquivo. Ele pode estar corrompido ou protegido por senha.');

            reader.onload = async function (e) {
                try {
                    const data = new Uint8Array(e.target.result);
                    const workbook = XLSX.read(data, { type: 'array', cellDates: true });

                    const { pedidos, relatorio } = lerPlanilhaCompleta(workbook);

                    // Nada encontrado: mostra o diagnóstico completo.
                    if (!pedidos.length) {
                        const det = relatorio
                            .map(r => `• ${r.aba}: ${r.status === 'ok'
                                ? r.lidos + ' pedido(s)'
                                : r.status}`)
                            .join('\n');

                        alert('Nenhum pedido encontrado nesta planilha.\n\n' +
                              'Abas lidas:\n' + det + '\n\n' +
                              'Para importar, a planilha precisa de uma aba com uma coluna ' +
                              'de número de pedido (ex.: "Nº do Pedido").\n\n' +
                              'Confira também se o arquivo é .xlsx ou .xls de verdade ' +
                              '(um .csv renomeado não funciona).');
                        return;
                    }

                    const abasBoas = relatorio.filter(r => r.status === 'ok');
                    const abasIgnoradas = relatorio.filter(r => r.status !== 'ok');
                    const totalSemEndereco = abasBoas.reduce((a, r) => a + (r.semEndereco || 0), 0);

                    const resumo =
                        `Abas com pedidos: ${abasBoas.map(r => `${r.aba} (${r.lidos})`).join(', ')}\n` +
                        (abasIgnoradas.length
                            ? `Abas ignoradas: ${abasIgnoradas.map(r => r.aba).join(', ')}\n`
                            : '') +
                        (totalSemEndereco
                            ? `\nATENÇÃO: ${totalSemEndereco} linha(s) NÃO entram por falta de endereço ` +
                              `completo (rua, número e bairro).\n`
                            : '') +
                        `\nTotal de pedidos: ${pedidos.length}\n\n` +
                        `Primeiros registros:\n` +
                        pedidos.slice(0, 5).map(p =>
                            `• ${p.numero} — ${p.cliente} (${p.cidade}/${p.uf}) — ` +
                            `${p.lonas} lona(s), ${p.forros} forro(s), ${p.cintas} cinta(s)`
                        ).join('\n') +
                        `\n\nConfirmar a importação?`;

                    if (!confirm(resumo)) return;

                    const resultado = await importarPedidosNoBanco(pedidos);
                    await recarregar();
                    closeModal('modal-import-excel');

                    if (resultado.erros && resultado.erros.length) {
                        alert(`${resultado.importados} pedido(s) importado(s).\n` +
                              `${resultado.erros.length} linha(s) com problema:\n\n` +
                              resultado.erros.slice(0, 8)
                                  .map(er => `Linha ${er.linha} (${er.numero || 'sem número'}): ${er.erro}`)
                                  .join('\n'));
                    } else {
                        showToast(`${resultado.importados} pedido(s) importado(s) com sucesso!`);
                    }
                } catch (err) {
                    console.error('Erro no import:', err);
                    alert('Erro ao processar a planilha:\n\n' + (err.message || err) +
                          '\n\nSe o arquivo abrir normalmente no Excel, salve como .xlsx e tente de novo.');
                }
            };

            reader.readAsArrayBuffer(file);
        }

