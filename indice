        /* ==========================================================
           JUSTIFICATIVA OBRIGATÓRIA NA BAIXA

           Toda baixa (entregue, coleta de cavalete, coleta de lona)
           passa por esta caixa: o que aconteceu e quem autorizou.
           ========================================================== */

        let JUST_PENDENTE = null;

        // Fecha e resolve como cancelada qualquer caixa que tenha ficado aberta,
        // para nunca sobrar um listener de uma baixa anterior.
        function limparJustificativaPendente() {
            if (!JUST_PENDENTE) return;
            const { onSubmit, observador, resolve } = JUST_PENDENTE;
            form_ref(JUST_PENDENTE.form, onSubmit);
            if (observador) observador.disconnect();
            JUST_PENDENTE = null;
            resolve(null);
        }

        function form_ref(form, onSubmit) {
            try { form.removeEventListener('submit', onSubmit); } catch (e) {}
        }

        function pedirJustificativa({ titulo, resumo, textoBotao }) {
            limparJustificativaPendente();

            return new Promise(resolve => {
                const modal = document.getElementById('modal-justificativa');
                const form  = document.getElementById('form-justificativa');
                const erro  = document.getElementById('just-erro');

                document.getElementById('just-titulo').textContent = titulo || 'Registrar baixa';
                document.getElementById('just-resumo').textContent = resumo || '';
                document.getElementById('just-obs').value = '';
                document.getElementById('just-autorizado').value = '';
                erro.classList.add('hidden');

                const botao = document.getElementById('just-confirmar');
                botao.textContent = textoBotao || 'Confirmar baixa';

                // "resolvido" evita que o fechamento do modal (que também
                // resolve como cancelado) apague o valor já confirmado.
                let resolvido = false;
                let observador = null;

                function encerrar(valor) {
                    if (resolvido) return;
                    resolvido = true;
                    form.removeEventListener('submit', onSubmit);
                    if (observador) observador.disconnect();
                    if (JUST_PENDENTE && JUST_PENDENTE.form === form) JUST_PENDENTE = null;
                    resolve(valor);
                    if (!modal.classList.contains('hidden')) closeModal('modal-justificativa');
                }

                function onSubmit(e) {
                    e.preventDefault();
                    const obs = document.getElementById('just-obs').value.trim();
                    const aut = document.getElementById('just-autorizado').value.trim();

                    if (!obs) {
                        erro.textContent = 'Descreva o que aconteceu antes de confirmar.';
                        erro.classList.remove('hidden');
                        return;
                    }
                    if (!aut) {
                        erro.textContent = 'Informe o nome de quem autorizou.';
                        erro.classList.remove('hidden');
                        return;
                    }
                    encerrar({ observacao: obs, autorizado: aut });
                }

                form.addEventListener('submit', onSubmit);
                JUST_PENDENTE = { form, onSubmit, observador: null, resolve };

                // fechar pelo X ou por Cancelar devolve "cancelado"
                observador = new MutationObserver(() => {
                    if (modal.classList.contains('hidden') && !resolvido) {
                        encerrar(null);
                    }
                });
                observador.observe(modal, { attributes: true, attributeFilter: ['class'] });
                if (JUST_PENDENTE && JUST_PENDENTE.form === form) JUST_PENDENTE.observador = observador;

                openModal('modal-justificativa');
                setTimeout(() => document.getElementById('just-obs').focus(), 100);
            });
        }

