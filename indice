async function iniciarSessao() {
    const { data: { session } } = await sb.auth.getSession();
    if (!session) {
        mostrarTelaLogin();
        return false;
    }
    await carregarPerfil();
    return true;
}

async function carregarPerfil() {
    const { data: { user } } = await sb.auth.getUser();
    if (!user) return;

    const { data, error } = await sb
        .from('profiles')
        .select('nome, papel, frota')
        .eq('id', user.id)
        .single();

    if (error) {
        console.error('Erro ao carregar perfil', error);
        return;
    }

    USUARIO = { id: user.id, ...data };
    // compatibilidade com bancos que ainda usem os nomes antigos
    PAPEL = ({ operador: 'pedidos', consulta: 'inventario' })[data.papel] || data.papel || 'inventario';
    PERFIL_ADMIN = PAPEL === 'admin';
}

async function entrar(email, senha) {
    const { error } = await sb.auth.signInWithPassword({ email, password: senha });
    if (error) return { ok: false, msg: traduzErroAuth(error.message) };
    await carregarPerfil();
    return { ok: true };
}

async function sair() {
    await sb.auth.signOut();
    location.reload();
}

function traduzErroAuth(msg) {
    if (/Invalid login credentials/i.test(msg)) return 'E-mail ou senha incorretos.';
    if (/Email not confirmed/i.test(msg))      return 'Confirme seu e-mail antes de entrar.';
    if (/rate limit/i.test(msg))               return 'Muitas tentativas. Aguarde um instante.';
    return msg;
}

